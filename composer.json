{
    "name": "working-code/comment-client",
    "description": "HTTP client for the example.com comments service",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "guzzlehttp/psr7": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "WorkingCode\\CommentClient\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Vlad Galushka",
            "email": "galushka.vp@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3",
        "guzzlehttp/guzzle": "^8.2"
    },
    "scripts": {
        "setup": "composer install --no-interaction",
        "tools:install": "composer install --working-dir=tools/php-cs-fixer --no-interaction",
        "test": [
            "@setup",
            "phpunit"
        ],
        "php-cs-fixer-diff": [
            "@setup",
            "@tools:install",
            "php -d memory_limit=-1 tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=tools/php-cs-fixer/.php-cs-fixer.dist.php --dry-run --diff"
        ],
        "php-cs-fixer-fix": [
            "@setup",
            "@tools:install",
            "php -d memory_limit=-1 tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=tools/php-cs-fixer/.php-cs-fixer.dist.php"
        ],
        "phpstan-full-scan": [
            "@setup",
            "php -d memory_limit=-1 vendor/bin/phpstan analyse --level=8 src"
        ],
        "lint": [
            "@php-cs-fixer-fix",
            "@phpstan-full-scan",
            "@test"
        ]
    }
}
