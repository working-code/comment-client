{
    "name": "working-code/comment-client",
    "description": "HTTP client for the example.com comments service",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "WorkingCode\\CommentClient\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Vlad Galushka",
            "email": "galushka.vp@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.3"
    },
    "scripts": {
        "test": "phpunit",
        "php-cs-fixer-diff": "php -d memory_limit=-1 tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=tools/php-cs-fixer/.php-cs-fixer.dist.php --dry-run --diff",
        "php-cs-fixer-fix": "php -d memory_limit=-1 tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --config=tools/php-cs-fixer/.php-cs-fixer.dist.php",
        "phpstan-full-scan": "php -d memory_limit=-1 vendor/bin/phpstan analyse --level=8 src",
        "lint": [
            "@php-cs-fixer-fix",
            "@phpstan-full-scan",
            "@test"
        ]
    }
}
